{
  "name": "nexussphere",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate_previews.js && node scripts/generate_assets_manifest.js && vite --port 5173 --strictPort",
    "dev:host": "node scripts/generate_previews.js && node scripts/generate_assets_manifest.js && vite --host --port 5173 --strictPort",
    "manifest": "node scripts/generate_assets_manifest.js && node scripts/generate_bundle.mjs",
    "previews": "node scripts/generate_previews.js",
    "build": "node scripts/generate_previews.js && node scripts/generate_assets_manifest.js && tsc && vite build && node scripts/cleanup_large_assets.mjs",
    "preview": "vite preview",
    "dev:server": "wrangler pages dev . --compatibility-date=2024-04-03 --d1 DB --port 8788",
    "deploy-assets": "node scripts/deploy_assets.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260418.1",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "typescript": "^5.7.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "wrangler": "^3.111.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@clerk/clerk-js": "^6.7.4",
    "@tonejs/midi": "^2.0.28",
    "dotenv": "^16.4.7",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "lil-gui": "^0.21.0",
    "spessasynth_lib": "^4.1.5"
  }
}
